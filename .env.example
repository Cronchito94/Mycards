# ---------------------------------------------------------------------------
# Copier en .env :  cp .env.example .env
# Le .env est gitignoré. N'y mettez jamais de secret dans .env.example.
# ---------------------------------------------------------------------------

# --- PostgreSQL (consommé par le service `db` de docker-compose) ---
POSTGRES_USER=tcg
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=tcg
# Port exposé sur la machine hôte (le port interne reste 5432)
POSTGRES_HOST_PORT=5432

# --- Connexion applicative ---
# `db` est le nom du service docker-compose : c'est le hostname sur le réseau
# interne. Pour lancer l'API hors Docker, remplacer par localhost.
DATABASE_URL=postgresql+psycopg://tcg:change-me-in-your-local-env@db:5432/tcg

# --- API ---
APP_ENV=dev
LOG_LEVEL=info
API_HOST_PORT=8000

# --- Référentiel TCGdex (lot 2) ---
# Par défaut l'instance auto-hébergée de docker-compose (service `tcgdex`).
TCGDEX_BASE_URL=http://tcgdex:3000
TCGDEX_HOST_PORT=3000
# Requêtes par seconde. 0 = illimité : valable en local uniquement.
# Contre l'API publique https://api.tcgdex.net, fixer une limite (ex. 10).
TCGDEX_RATE_LIMIT=0
TCGDEX_CONCURRENCY=16

# --- Sources de prix (lot 5, non utilisées ici) ---
# Voir CLAUDE.md : les sources de la spec ont changé, à rediscuter.
# POKEMONTCG_IO_API_KEY=
